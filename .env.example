# Contact form email (iCloud+ custom domain over SMTP). See README → "Contact form email".

SMTP_HOST=smtp.mail.me.com
# 587 uses STARTTLS; 465 uses implicit TLS. SMTP_SECURE=true|false overrides.
SMTP_PORT=587
# Must be the Apple ID's primary @icloud.com address — iCloud rejects custom-domain
# addresses as an SMTP login (535 authentication failed).
SMTP_USER=yourname@icloud.com
# An app-specific password generated on that same Apple ID, not the account password.
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# A custom-domain address on the same Apple ID. Falls back to SMTP_USER if unset.
CONTACT_FROM_EMAIL=hello@sparkcollective.lk
# Where enquiries land. Falls back to CONTACT_EMAIL in lib/contact.ts if unset.
CONTACT_TO_EMAIL=hello@sparkcollective.lk

NEXT_PUBLIC_SITE_URL=https://sparkcollective.lk
